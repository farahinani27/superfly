# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
# WooCommerce build (the test site, NOT the live Unicart store).
# WP_APP_PASSWORD is a WordPress Application Password (an API token),
# created in WP Admin > Users > Profile > Application Passwords.
# It is not the login password.
WP_BASE_URL=https://superfly.durianbikers.com
WP_API_USER=
WP_APP_PASSWORD=
