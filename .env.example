# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
# WooCommerce build (the test site, NOT the live Unicart store).
# WP_APP_PASSWORD is a WordPress Application Password (an API token),
# created in WP Admin > Users > Profile > Application Passwords.
# It is NOT your login password — the REST API rejects login passwords.
#
# IMPORTANT: wrap the password in double quotes. WordPress shows it as six
# blocks separated by spaces, and an unquoted value stops at the first space,
# so only 4 of the 24 characters reach the server and you get a 401.
#   right:  WP_APP_PASSWORD="abcd EFGH ijkl MNOP qrst UVWX"
#   wrong:  WP_APP_PASSWORD=abcd EFGH ijkl MNOP qrst UVWX
WP_BASE_URL=https://superfly.durianbikers.com
WP_API_USER=
WP_APP_PASSWORD=""
